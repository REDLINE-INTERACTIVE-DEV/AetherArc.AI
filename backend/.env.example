# === AetherArc Backend ===
# Copy to .env — NEVER commit .env

APP_NAME=AetherArc
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string-now

DATABASE_URL=sqlite+aiosqlite:///./aether.db

# SERVER-SIDE ONLY — users never paste this
AI_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=openai/gpt-oss-20b

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]
