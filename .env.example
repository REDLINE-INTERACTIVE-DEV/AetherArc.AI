# Aether model provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI-compatible model provider
# AETHER_MODEL_BASE_URL=https://your-provider.example/v1
# AETHER_MODEL_API_KEY=
# AETHER_MODEL=your-model

# Optional local Ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ResearchAI optional Google Custom Search
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Image generation (Pollinations)
# Keep this server-side; never put it in the APK.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux

# Composio tool layer for GitHub and other external actions
# Create/authorize the connection in your Composio project first.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
AETHER_GITHUB_OWNER=REDLINE-INTERACTIVE-DEV
AETHER_GITHUB_REPO=AetherArc.AI
AETHER_GITHUB_BRANCH=main
# AETHER_GITHUB_PATH=frontend/app.js
